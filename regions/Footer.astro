---
import type { ThemeFooterProps } from '@kometio/theme-runtime';

/**
 * The same band as the header, turned the other way up: the check along its
 * upper edge, the colors turned over inside it. The two files repeat the
 * same eight tokens on purpose: a region is one file, and the values they
 * take come from theme.css, so neither can drift from the other.
 */
export type Props = ThemeFooterProps;

const { class: className } = Astro.props;
---

<footer class:list={['gingham-footer', className]}>
  <slot />
</footer>

<style>
  .gingham-footer {
    --background: var(--gingham-green);
    --foreground: var(--gingham-on-green);
    --primary: var(--gingham-gold);
    --primary-foreground: var(--gingham-green);
    --muted: rgb(246 239 224 / 0.12);
    --muted-foreground: var(--gingham-on-green-muted);
    --border: var(--gingham-on-green-line);
    --link: var(--primary);
    --link-hover: var(--foreground);

    position: relative;
    background: var(--background);
    color: var(--foreground);
    padding: calc(0.75rem + clamp(2rem, 1.5rem + 3vw, 4rem))
      var(--kometio-content-gutter) clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .gingham-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 0.75rem;
    background-color: var(--gingham-cloth);
    background-image:
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--gingham-check) 55%, transparent) 0 0.375rem,
        transparent 0.375rem 0.75rem
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--gingham-check) 55%, transparent) 0 0.375rem,
        transparent 0.375rem 0.75rem
      );
  }
</style>
