---
import type { ThemeHeaderProps } from '@kometio/theme-runtime';

/**
 * rung 3 of the ladder: the element that wraps the header's blocks. The blocks
 * themselves (the name, the menu, the language switcher) are the site
 * owner's, put there in the editor; they arrive as the slot, and this file
 * decides only what they sit in.
 *
 * What it does: a bottle-green band with the page's colors turned over inside
 * it, and a strip of check, like a tablecloth, along its lower edge. It turns
 * them over by redefining the color tokens on the header alone, so every
 * block inside follows (a Link, a Button, a language switcher) without an
 * override of its own. And it keeps its own `<slot />`: a region that forgets
 * it makes the whole page disappear, silently.
 */
export type Props = ThemeHeaderProps;

const { sticky, class: className } = Astro.props;
---

<header
  class:list={[
    'gingham-header',
    className,
    { 'gingham-header--sticky': sticky },
  ]}
>
  <slot />
</header>

<style>
  .gingham-header {
    --background: var(--gingham-green);
    --foreground: var(--gingham-on-green);
    --primary: var(--gingham-gold);
    --primary-foreground: var(--gingham-green);
    --muted: rgb(246 239 224 / 0.12);
    --muted-foreground: var(--gingham-on-green-muted);
    --border: var(--gingham-on-green-line);
    --link: var(--primary);
    --link-hover: var(--foreground);

    position: relative;
    background: var(--background);
    color: var(--foreground);
    /* The padding below is the strip's height again, so the blocks do not sit
       on the check. */
    padding: 0.875rem var(--kometio-content-gutter) 1.625rem;
  }

  /* Sticky is the header editor's switch. The band stays at the top while the
     page scrolls under it. */
  .gingham-header--sticky {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /* The check: two sets of stripes, one across the other, each half
     transparent, which is how a gingham cloth is woven. Drawn inside the
     header's own box (never wider than the page, which would make the page
     scroll sideways). */
  .gingham-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 0.75rem;
    background-color: var(--gingham-cloth);
    background-image:
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--gingham-check) 55%, transparent) 0 0.375rem,
        transparent 0.375rem 0.75rem
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--gingham-check) 55%, transparent) 0 0.375rem,
        transparent 0.375rem 0.75rem
      );
  }
</style>
